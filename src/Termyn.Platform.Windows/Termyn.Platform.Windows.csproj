<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- The tray icon is a NotifyIcon and the hotkey needs a message pump, so the platform layer
         sits on WinForms too. It stays free of the app's own windows and presenters. -->
    <UseWindowsForms>true</UseWindowsForms>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Termyn.Core\Termyn.Core.csproj" />
  </ItemGroup>

</Project>
