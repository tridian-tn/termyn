<Project>

  <!-- What a test project needs to run as a Mac app bundle. Imported by each one, which adds an
       ApplicationId of its own, so anything macOS keeps for the process (its defaults above all)
       lands somewhere other than the real app's. -->

  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <!-- See Termyn.Platform.Mac.csproj: the workload names an older Xcode than the one in use. -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <!-- MacTestMain.cs instead, which explains why. -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <!-- The bundle's own executable rather than `open`, which hands the app to Launch Services and
         comes straight back, leaving `dotnet test` nothing to talk to. -->
    <RunWithOpen>false</RunWithOpen>
    <!-- Never trimmed, in any configuration: xunit finds the tests by reflection. A Release build
         of an app trims it unless told otherwise, and the workload's analyzer warns about the
         reflection these tests do on themselves. -->
    <LinkMode>None</LinkMode>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)MacTestMain.cs" Link="MacTestMain.cs" />
    <!-- Where xunit generates what the entry point registers, which is named for the project. -->
    <Using Include="$(MSBuildProjectName)" />
  </ItemGroup>

  <!-- xunit refuses a project without an app host, since its runners start a test project through
       one, and the macOS workload never builds one: it has the bundle's executable instead, which
       is what's run here. So xunit is told yes for as long as it's asking. Left on, the workload
       warns that it has an app host it can't place in the bundle. -->
  <Target Name="_SayAppHostToXunit" BeforeTargets="_XunitValidateBuild">
    <PropertyGroup>
      <UseAppHost>true</UseAppHost>
    </PropertyGroup>
  </Target>

  <Target Name="_NoAppHostAfterXunit" AfterTargets="_XunitValidateBuild">
    <PropertyGroup>
      <UseAppHost>false</UseAppHost>
    </PropertyGroup>
  </Target>

</Project>
