<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ICU is required: the account's timezone arrives as an IANA name, which cannot be resolved
         without it, and the smart views are defined against the account's date. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- The language the strings in the .resx files are written in, and the one that lives in the
         assembly itself rather than beside it. Nothing is translated yet; saying so is what lets a
         machine set to any culture fall back to these without going looking for a satellite that
         was never built.

         NeutralLanguage and not NeutralResourcesLanguage: the second is what the attribute is
         called and sets nothing at all from here, which is a quiet way to have none of this. -->
    <NeutralLanguage>en-GB</NeutralLanguage>
  </PropertyGroup>

  <!-- The version a dev build stamps itself with, read back at runtime by the update check and
       shown in the about box. A release build gets its version from the tag instead — the packaging
       job passes it to publish, so an assembly cut from a tag carries the tag's number regardless
       of what is here. Left as something a running app can still report so `dotnet run` shows
       something meaningful. -->
  <PropertyGroup>
    <Version>0.2.0</Version>
    <Company>Tridian</Company>
    <Product>Termyn</Product>
    <Copyright>Copyright © Trystan Negus</Copyright>
  </PropertyGroup>
</Project>
