<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Generated into obj/ on every build rather than checked in beside the .resx. A designer file
       committed to the repo is one only an IDE regenerates, so it drifts the first time a string is
       added from a terminal and nothing notices until a key is missing at runtime. -->
  <ItemGroup>
    <EmbeddedResource Update="Strings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Termyn.Core</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Override the vulnerable native SQLite (CVE-2025-6965, CVE-2025-70873) that Microsoft.Data.Sqlite
         still pulls transitively. This package's version tracks the bundled SQLite version; drop the
         override once Microsoft.Data.Sqlite resolves a patched native on its own. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

</Project>
