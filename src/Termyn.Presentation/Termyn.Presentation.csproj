<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Generated into obj/ on every build rather than checked in beside the .resx. A designer file
       committed to the repo is one only an IDE regenerates, so it drifts the first time a string is
       added from a terminal and nothing notices until a key is missing at runtime. -->
  <ItemGroup>
    <EmbeddedResource Update="Strings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Termyn.Presentation</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Reads the markdown a description is written in, so the box you type into can show what it
         means. Here rather than in the UI project because the answer is the same whatever draws
         it, and because that is what lets it be tested without a control to look at. -->
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Termyn.Core\Termyn.Core.csproj" />
  </ItemGroup>

</Project>
