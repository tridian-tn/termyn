<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ICU is required: the account's timezone arrives as an IANA name, which cannot be resolved
         without it, and the smart views are defined against the account's date. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- One version for the whole product, read back at runtime by the update check and shown in the
       about box. Release tags are this number with a leading v. -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Company>Tridian</Company>
    <Product>Termyn</Product>
    <Copyright>Copyright © Trystan Negus</Copyright>
  </PropertyGroup>
</Project>
