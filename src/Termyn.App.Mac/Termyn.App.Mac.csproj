<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-macos</TargetFramework>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Termyn.app, not Termyn.App.Mac.app: the bundle is named after the assembly. -->
    <AssemblyName>Termyn</AssemblyName>
    <RootNamespace>Termyn.App.Mac</RootNamespace>
    <ApplicationTitle>Termyn</ApplicationTitle>
    <ApplicationId>net.tridian.termyn</ApplicationId>
    <!-- From the props' placeholder, as the Windows build is: the release tag is the only real
         version, and anything else calls itself 0.0.0. -->
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>$(Version)</ApplicationVersion>
    <!-- See Termyn.Platform.Mac.csproj: the workload names an older Xcode than the one in use. -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
  </PropertyGroup>

  <!-- Generated into obj/ on every build rather than checked in beside the .resx, as in the other
       projects: a committed designer file drifts the first time a string is added from a terminal. -->
  <ItemGroup>
    <EmbeddedResource Update="Strings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Termyn.App.Mac</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Termyn.Core\Termyn.Core.csproj" />
    <ProjectReference Include="..\Termyn.Presentation\Termyn.Presentation.csproj" />
    <ProjectReference Include="..\Termyn.Platform.Mac\Termyn.Platform.Mac.csproj" />
  </ItemGroup>

</Project>
